---
import CourseworkDetails from './CourseworkDetails.astro';
const toolkit = [
  {
    group: "Languages",
    tools: [
      { name: "TypeScript", icon: "devicon-typescript-plain" },
      { name: "C#", icon: "devicon-csharp-plain" },
      { name: "C++", icon: "devicon-cplusplus-plain" },
      { name: "Python", icon: "devicon-python-plain" },
    ],
  },
  {
    group: "Game Dev",
    tools: [
      { name: "Unity", icon: "devicon-unity-plain" },
      { name: "Unreal", icon: "devicon-unrealengine-original" },
      { name: "Godot", icon: "devicon-godot-plain" },
    ],
  },
  {
    group: "Web & Backend",
    tools: [
      { name: "Astro", icon: "devicon-astro-plain" },
      { name: "React", icon: "devicon-react-original" },
      { name: "Node", icon: "devicon-nodejs-plain" },
      { name: "SQLite", icon: "devicon-sqlite-plain" },
    ],
  },
  {
    group: "Cloud & Ops",
    tools: [
      { name: "AWS", icon: "devicon-amazonwebservices-plain-wordmark" },
      { name: "Docker", icon: "devicon-docker-plain" },
      { name: "Linux", icon: "devicon-linux-plain" },
      { name: "Git", icon: "devicon-git-plain" },
    ],
  },
  {
    group: "AI & Automation",
    tools: [
      { name: "n8n", icon: "fa-solid fa-robot" },
      { name: "LLM APIs", icon: "fa-solid fa-brain" },
    ],
  },
];
---
<section id="background" class="pb-10">
  <h2 class="text-xs uppercase tracking-[0.3em] text-slate-500 mb-4 border-b border-white/5 pb-4 font-mono">
    Background & Stack
  </h2>

  <!-- Education -->
  <div class="space-y-12 mb-20">
    <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-2">
      <div>
        <h3 class="text-xl font-medium text-accent">Collège de Bois-de-Boulogne</h3>
        <p class="text-sm font-mono text-slate-500 mt-2">A.E.C. - Video Game Programming</p>
      </div>
      <span class="text-sm font-mono text-slate-600">2022 — 2023</span>
    </div>
    <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-2">
      <div>
        <h3 class="text-xl font-medium text-accent">Concordia University</h3>
        <p class="text-sm font-mono text-slate-500 mt-2">Bachelors - Civil Engineering (56 credits)</p>
      </div>
      <span class="text-sm font-mono text-slate-600">2008 — 2011</span>
    </div>
  </div>

  <div data-project-grid class="mb-12 grid grid-cols-1 gap-4">
    <button type="button" data-project-trigger="unreal-engine-5" aria-expanded="false" aria-controls="project-detail-unreal-engine-5" style="--accent:#e5e7eb" class="group flex min-h-16 items-center justify-between gap-4 rounded-xl border border-white/10 bg-white/[0.02] px-5 py-4 text-left transition-colors hover:border-white/25 focus-visible:outline-2 focus-visible:outline-accent">
      <span>
        <span class="block text-[10px] font-mono uppercase tracking-[0.16em] text-slate-500">Further study</span>
        <span class="mt-1 block text-sm text-slate-300">Unreal Engine 5 · C++ & multiplayer coursework</span>
      </span>
      <i class="fa-solid fa-chevron-down text-xs text-slate-500 transition-transform group-aria-expanded:rotate-180" aria-hidden="true"></i>
    </button>
    <CourseworkDetails />
  </div>

  <!-- Core Stack -->
  <div class="pt-10 border-t border-white/5">
    <h4 class="text-xs uppercase tracking-[0.2em] text-slate-600 mb-10 font-mono mt-10">Toolkit</h4>
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-x-6 gap-y-12">
      {toolkit.map((cat) => (
        <div>
          <p class="text-[10px] uppercase tracking-[0.22em] text-slate-600 font-mono mb-6">{cat.group}</p>
          <ul class="space-y-4">
            {cat.tools.map((tool) => (
              <li class="group flex items-center gap-3 cursor-default">
                <i class={`${tool.icon} text-2xl text-slate-500 opacity-50 group-hover:opacity-100 group-hover:text-accent transition-all`}></i>
                <span class="text-sm text-slate-500 group-hover:text-accent transition-colors">{tool.name}</span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>
