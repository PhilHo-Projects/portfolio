---
---
<section id="background" class="pb-10">
  <h2 class="text-xs uppercase tracking-[0.3em] text-slate-500 mb-4 border-b border-white/5 pb-4 font-mono">
    Background & Stack
  </h2>

  <!-- Education -->
  <div class="space-y-12 mb-20">
    <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-2">
      <div>
        <h3 class="text-xl font-medium text-accent">Collège de Bois-de-Boulogne</h3>
        <p class="text-sm font-mono text-slate-500 mt-2">A.E.C. - Video Game Programming</p>
      </div>
      <span class="text-sm font-mono text-slate-600">2022 — 2023</span>
    </div>
    <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-2">
      <div>
        <h3 class="text-xl font-medium text-accent">Concordia University</h3>
        <p class="text-sm font-mono text-slate-500 mt-2">Bachelors - Civil Engineering (56 credits)</p>
      </div>
      <span class="text-sm font-mono text-slate-600">2008 — 2011</span>
    </div>
  </div>

  <!-- Core Stack -->
  <div class="pt-10 border-t border-white/5">
    <h4 class="text-xs uppercase tracking-[0.2em] text-slate-600 mb-10 font-mono mt-10">Toolkit</h4>
    <ul class="flex flex-wrap gap-12 text-5xl opacity-30">
      <li title="C++" class="hover:text-accent hover:opacity-100 transition-all"><i class="devicon-cplusplus-plain"></i></li>
      <li title="C#" class="hover:text-accent hover:opacity-100 transition-all"><i class="devicon-csharp-plain"></i></li>
      <li title="Unity" class="hover:text-accent hover:opacity-100 transition-all"><i class="devicon-unity-plain"></i></li>
      <li title="Unreal Engine" class="hover:text-accent hover:opacity-100 transition-all"><i class="devicon-unrealengine-original"></i></li>
      <li title="Godot" class="hover:text-accent hover:opacity-100 transition-all"><i class="devicon-godot-plain"></i></li>
      <li title="Python" class="hover:text-accent hover:opacity-100 transition-all"><i class="devicon-python-plain"></i></li>
      <li title="AWS" class="hover:text-accent hover:opacity-100 transition-all"><i class="devicon-amazonwebservices-plain-wordmark"></i></li>
      <li title="Docker" class="hover:text-accent hover:opacity-100 transition-all"><i class="devicon-docker-plain"></i></li>
      <li title="Git" class="hover:text-accent hover:opacity-100 transition-all"><i class="devicon-git-plain"></i></li>
    </ul>
  </div>
</section>
