---
// Bump this after tagging a release; every link and label below follows from it.
const version = '1.0.0';

const screenshot = import.meta.env.BASE_URL + `assets/img/music-player-v${version}.png`;
const repository = 'https://github.com/PhilHo-Projects/MusicPlayer';
const release = `${repository}/releases/tag/v${version}`;
const windowsDownload = `${repository}/releases/download/v${version}/MusicPlayer-v${version}.zip`;
const macDownload = `${repository}/releases/download/v${version}/MusicPlayer-macos-v${version}.zip`;

const proofPoints = [
  { label: 'Traktor BPM + key', icon: 'fa-solid fa-record-vinyl' },
  { label: 'Live FFT spectrum', icon: 'fa-solid fa-wave-square' },
  { label: '10-band EQ', icon: 'fa-solid fa-sliders' },
];
---

<article
  id="project-detail-music-player"
  data-project-detail="music-player"
  hidden
  aria-labelledby="project-heading-music-player"
  data-featured-project="music-player"
  data-feature-layout="stacked"
  class="col-span-full overflow-hidden rounded-2xl border border-orange-400/20 bg-[#171411]"
>
  <div class="p-6 sm:p-8 lg:p-9">
    <div class="flex flex-wrap items-center justify-between gap-3">
      <span class="inline-flex items-center gap-2 rounded-full bg-orange-400/10 px-3 py-1.5 text-[10px] font-mono uppercase tracking-[0.16em] text-orange-300">
        <span class="h-1.5 w-1.5 rounded-full bg-orange-400"></span>
        Released desktop app
      </span>
      <span class="inline-flex items-center gap-1.5 text-[10px] font-mono uppercase tracking-[0.14em] text-slate-400">
        <i class="devicon-rust-plain text-sm text-orange-400"></i>
        Rust · Windows · macOS
      </span>
    </div>

    <p class="mt-7 text-[10px] font-mono uppercase tracking-[0.16em] text-orange-400">Native DJ-focused audio player</p>
    <h4 id="project-heading-music-player" class="mt-2 text-3xl font-medium leading-tight tracking-[-0.025em] text-white">MusicPlayer</h4>
    <p class="mt-4 max-w-3xl text-sm leading-relaxed text-slate-400">
      A native desktop player built for DJs. It reads Traktor's own analysis, so a track opens with its BPM, musical key, and a spectral waveform you can jump through a bar at a time. Handles MP3, WAV, FLAC, M4A, and AAC.
    </p>

    <figure class="group relative mt-7 overflow-hidden rounded-xl border border-white/10 bg-[#0d0d0d]">
      <img
        src={screenshot}
        alt={`MusicPlayer v${version} playing a Traktor-analyzed track, showing cover art, the detected BPM and key, a live spectrum, and a spectral waveform`}
        class="aspect-[1.405/1] w-full object-cover object-center transition-transform duration-500 ease-out group-hover:scale-[1.01] sm:aspect-[8/5]"
      />
      <span class="absolute inset-0 bg-gradient-to-t from-black/70 via-transparent to-transparent"></span>
      <span class="absolute inset-x-4 bottom-4 flex items-end justify-between gap-4 sm:inset-x-5 sm:bottom-5">
        <span class="inline-flex items-center gap-2 rounded-md bg-black/80 px-3 py-2 text-[10px] font-mono uppercase tracking-[0.14em] text-orange-100">
          <i class="fa-solid fa-camera text-orange-400"></i>
          Captured from v{version}
        </span>
      </span>
    </figure>

    <div class="mt-7 grid grid-cols-1 gap-8 lg:grid-cols-[1.1fr_0.9fr] lg:gap-10">
      <div>
        <ul class="grid grid-cols-1 gap-2 sm:grid-cols-3" aria-label="MusicPlayer highlights">
          {proofPoints.map((point) => (
            <li class="flex items-center gap-3 rounded-lg bg-black/20 px-3 py-2.5 text-[11px] font-mono text-slate-300">
              <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-md bg-orange-400/10 text-orange-400">
                <i class={`${point.icon} text-[10px]`}></i>
              </span>
              {point.label}
            </li>
          ))}
        </ul>
      </div>

      <div class="border-t border-white/10 pt-7 lg:border-t-0 lg:border-l lg:pt-0 lg:pl-8">
        <p class="text-[10px] font-mono uppercase tracking-[0.14em] text-slate-400">Download v{version}</p>
        <div class="mt-3 grid grid-cols-1 gap-2 sm:grid-cols-2 lg:grid-cols-1">
          <a
            data-download="windows"
            href={windowsDownload}
            target="_blank"
            rel="noreferrer"
            class="inline-flex min-h-11 items-center justify-center gap-2 rounded-lg bg-orange-400 px-4 py-3 text-[10px] font-mono font-semibold uppercase tracking-[0.13em] text-[#1b1008] transition-colors hover:bg-orange-300 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-orange-300"
          >
            <i class="fa-brands fa-windows text-sm"></i>
            Download Windows
          </a>
          <a
            data-download="macos"
            href={macDownload}
            target="_blank"
            rel="noreferrer"
            class="inline-flex min-h-11 items-center justify-center gap-2 rounded-lg border border-white/15 bg-white/5 px-4 py-3 text-[10px] font-mono font-semibold uppercase tracking-[0.13em] text-slate-200 transition-colors hover:border-orange-300/40 hover:bg-orange-400/5 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-orange-300"
          >
            <i class="fa-brands fa-apple text-sm"></i>
            Download macOS
          </a>
        </div>

        <div class="mt-4 flex flex-wrap items-center gap-x-5 gap-y-2 text-[10px] font-mono uppercase tracking-[0.12em]">
          <a data-secondary-action="source" href={repository} target="_blank" rel="noreferrer" class="inline-flex min-h-11 items-center text-slate-400 transition-colors hover:text-orange-300">
            <i class="fa-brands fa-github mr-1.5"></i>View source
          </a>
          <a data-secondary-action="release" href={release} target="_blank" rel="noreferrer" class="inline-flex min-h-11 items-center text-slate-400 transition-colors hover:text-orange-300">
            Release notes<i class="fa-solid fa-arrow-up-right-from-square ml-1.5 text-[8px]"></i>
          </a>
        </div>

        <p data-build-warning class="mt-5 flex items-start gap-2 text-[10px] leading-relaxed text-slate-400">
          <i class="fa-solid fa-shield-halved mt-0.5 text-orange-400/70"></i>
          <span>Unsigned indie build — Windows SmartScreen or macOS Gatekeeper may ask for confirmation.</span>
        </p>
      </div>
    </div>
  </div>
  <button type="button" data-collapse-project="music-player" class="m-6 inline-flex min-h-11 items-center rounded-lg border border-white/15 px-4 py-3 text-[10px] font-mono uppercase tracking-[0.14em] text-slate-300">Collapse details</button>
</article>
