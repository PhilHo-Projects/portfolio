---
import { experience } from '../data/experience';
---

<section id="experience">
  <h2 class="text-xs uppercase tracking-[0.3em] text-slate-500 mb-4 border-b border-white/5 pb-4 font-mono">
    Experience
  </h2>
  <div class="space-y-16">
    {experience.map((job) => (
      <div>
        <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-2 mb-4">
          <h3 class="text-2xl font-medium text-accent">{job.company}</h3>
          <span class="text-xs font-mono text-slate-600 uppercase tracking-wider">{job.startDate} — {job.endDate}</span>
        </div>
        <p class="text-base font-mono text-slate-500 mb-6 italic">{job.role}</p>
        <p class="mb-8 leading-relaxed">
          {job.description}
        </p>
        {job.link && (
          <a href={job.link} target="_blank" rel="noreferrer" class="block group">
            <div class="game-video-container border border-white/10 group-hover:border-accent/30 transition-colors">
              <video autoplay loop muted playsinline class="game-video" loading="lazy">
                <source src={job.videoSrc} type="video/webm" />
              </video>
            </div>
          </a>
        )}
      </div>
    ))}
  </div>
</section>
