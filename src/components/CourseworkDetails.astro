---
import { certificates } from '../data/certificates';
---

<article
  id="project-detail-unreal-engine-5"
  data-project-detail="unreal-engine-5"
  hidden
  class="project-detail col-span-full overflow-hidden rounded-2xl border border-white/10 bg-[#141414] p-6 opacity-0 translate-y-2 transition duration-200 motion-reduce:transition-none sm:p-8"
  aria-labelledby="project-heading-unreal-engine-5"
>
  <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <p class="text-[10px] font-mono uppercase tracking-[0.16em] text-slate-400">Completed coursework</p>
      <h3 id="project-heading-unreal-engine-5" class="mt-2 text-2xl font-medium text-white sm:text-3xl">Unreal Engine 5 in C++</h3>
    </div>
    <p class="max-w-xl text-sm leading-relaxed text-slate-500 sm:text-right">
      Three focused courses covering gameplay foundations, replicated combat, and production-minded dedicated server infrastructure.
    </p>
  </div>

  <div class="mt-7 grid gap-4 md:grid-cols-3">
    {certificates.map(course => (
      <a
        data-coursework-card
        href={course.href}
        target="_blank"
        rel="noreferrer"
        class="group flex min-h-full flex-col overflow-hidden rounded-xl border border-white/10 bg-black/20 transition-colors hover:border-white/25 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
        aria-label={`View ${course.title} on Udemy`}
      >
        <span class="aspect-video overflow-hidden border-b border-white/10 bg-black">
          <img
            src={import.meta.env.BASE_URL + course.image}
            alt={course.imageAlt}
            width="1280"
            height="720"
            loading="lazy"
            decoding="async"
            class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.025] motion-reduce:transition-none"
          />
        </span>
        <span class="flex flex-1 flex-col p-5">
          <span class="text-[10px] font-mono uppercase tracking-[0.15em] text-slate-500">Instructor · {course.instructor}</span>
          <span class="mt-2 text-sm font-medium leading-snug text-slate-100">{course.title}</span>
          <span class="mt-3 text-xs leading-relaxed text-slate-400">{course.desc}</span>
          <span class="mt-5 inline-flex items-center gap-2 text-[10px] font-mono font-semibold uppercase tracking-[0.15em] text-white md:mt-auto md:pt-5">
            View course
            <i class="fa-solid fa-arrow-up-right-from-square text-[9px] transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5" aria-hidden="true"></i>
          </span>
        </span>
      </a>
    ))}
  </div>

  <button
    type="button"
    data-collapse-project="unreal-engine-5"
    class="mt-6 inline-flex min-h-11 items-center rounded-lg border border-white/15 px-4 py-3 text-[10px] font-mono uppercase tracking-[0.14em] text-slate-300 transition-colors hover:border-white/30 hover:text-white"
  >
    Collapse details
  </button>
</article>
