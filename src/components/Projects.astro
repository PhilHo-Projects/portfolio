---
import { projects, type Project } from '../data/projects';
import ProjectCard from './ProjectCard.astro';
import StandardProjectDetails from './StandardProjectDetails.astro';
import JobScraperCaseStudy from './JobScraperCaseStudy.astro';
import MusicPlayerFeatured from './MusicPlayerFeatured.astro';
import BillingHubFeatured from './BillingHubFeatured.astro';
import CourseworkDetails from './CourseworkDetails.astro';

const categories = [
  ['web-development', 'Web Development'],
  ['game-development', 'Game Development'],
  ['automation', 'Automation & Systems'],
  ['native-tools', 'Native & Tools'],
] as const;

const visibleProjects = projects.filter(project => project.visible !== false);

---

<section id="projects" class="pb-10">
  <h2 class="mb-4 border-b border-white/5 pb-4 text-xs font-mono uppercase tracking-[0.3em] text-slate-500">Projects</h2>
  <div class="space-y-10">
    {categories.map(([anchor, category]) => (
      <div id={anchor}>
        <h3 class="mb-6 text-xs font-mono uppercase tracking-widest text-slate-600">{category}</h3>
        <div data-project-grid class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3 md:gap-5">
          {visibleProjects.filter(project => project.category === category).map(project => (
            <>
              <ProjectCard project={project} />
              {project.detail === 'billing-hub' && <BillingHubFeatured />}
              {project.detail === 'job-scraper' && <JobScraperCaseStudy />}
              {project.detail === 'music-player' && <MusicPlayerFeatured />}
              {project.detail === 'standard' && <StandardProjectDetails project={project} />}
              {project.detail === 'coursework' && <CourseworkDetails />}
            </>
          ))}
        </div>
      </div>
    ))}
  </div>
</section>
