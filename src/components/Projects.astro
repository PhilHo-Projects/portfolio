---
import { projects, type Project } from '../data/projects';
import ProjectCard from './ProjectCard.astro';
import StandardProjectDetails from './StandardProjectDetails.astro';
import JobScraperCaseStudy from './JobScraperCaseStudy.astro';
import MusicPlayerFeatured from './MusicPlayerFeatured.astro';
import BillingHubFeatured from './BillingHubFeatured.astro';

const sections = [
  {
    id: 'selected-work',
    title: 'Selected work',
    description: 'Original games, useful products, and the systems behind them.',
    ids: ['hidden', 'personal-soundcloud', 'music-player', 'job-scraper', 'billing-hub', 'philchat', 'tokentracker', 'chatsim', 'manga-tracker'],
    compact: false,
  },
  {
    id: 'experiments',
    title: 'Experiments & explorations',
    description: 'Smaller tools, procedural worlds, and ideas in progress.',
    ids: ['shaderlab', 'health-hub', 'wave-function-collapse', 'turboreader', 'classaction-scanner'],
    compact: true,
  },
];
const findProject = (id: string) => projects.find(project => project.id === id && project.visible !== false);

---

<section id="projects" class="pb-10">
  <div class="space-y-14">
    {sections.map(section => (
      <div id={section.id}>
        <div class="mb-6 border-b border-white/5 pb-4">
          <h2 class="text-xs font-mono uppercase tracking-[0.3em] text-slate-400">{section.title}</h2>
          <p class="mt-3 text-sm leading-relaxed text-slate-500">{section.description}</p>
        </div>
        <div data-project-grid class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3 md:gap-5">
          {section.ids.map(findProject).filter((project): project is Project => Boolean(project)).map(project => (
            <>
              <ProjectCard project={project} compact={section.compact} />
              {project.detail === 'billing-hub' && <BillingHubFeatured />}
              {project.detail === 'job-scraper' && <JobScraperCaseStudy />}
              {project.detail === 'music-player' && <MusicPlayerFeatured />}
              {project.detail === 'standard' && <StandardProjectDetails project={project} />}
            </>
          ))}
        </div>
      </div>
    ))}
  </div>
</section>
