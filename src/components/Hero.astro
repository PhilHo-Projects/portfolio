---
---
<section class="mb-32 flex flex-col items-center md:items-start text-center md:text-left">
  <div class="flex flex-col-reverse md:flex-row md:items-center md:justify-between gap-12 mb-16 w-full">
    <div class="flex flex-col items-center md:items-start">
      <h1 class="text-6xl font-mono font-medium tracking-tighter text-name-bright">
        Philippe Ho
      </h1>
      <p class="mt-6 text-2xl leading-relaxed text-slate-300">
        Software/Game Developer
      </p>
    </div>
    <div class="shrink-0 mx-auto md:mx-0">
      <img src={import.meta.env.BASE_URL + "assets/img/profile2.webp"} alt="Philippe Ho"
        class="w-40 h-40 rounded-full border border-white/10 object-cover shadow-2xl" />
    </div>
  </div>

  <div class="space-y-10 max-w-3xl leading-relaxed">
    <p>
      Hi! I'm a Montreal-based developer focused on Unity and Unreal Engine. After shipping a title on Steam, I've
      been diving into multiplayer development and experimenting with AI-assisted development and workflows.
    </p>
  </div>

  <div class="mt-20 flex gap-10 text-3xl justify-center md:justify-start">
    <a class="text-slate-500 hover:text-name-bright transition-colors" href="https://github.com/PhilippeHo27"
      target="_blank" rel="noreferrer" aria-label="GitHub">
      <i class="fa-brands fa-github"></i>
    </a>
    <a class="text-slate-500 hover:text-name-bright transition-colors"
      href="https://www.linkedin.com/in/philippe-ho" target="_blank" rel="noreferrer" aria-label="LinkedIn">
      <i class="fa-brands fa-linkedin-in"></i>
    </a>
    <a class="text-slate-500 hover:text-name-bright transition-colors" href="#"
      onclick="window.openResume?.(); return false;" aria-label="Resume">
      <i class="fa-regular fa-file-pdf"></i>
    </a>
    <a class="group relative text-slate-500 hover:text-name-bright transition-colors" href="#"
      onclick="window.copyEmail?.(event); return false;" aria-label="Email">
      <i class="fa-regular fa-envelope"></i>
      <span
        class="absolute bottom-full left-1/2 -translate-x-1/2 mb-3 px-3 py-1.5 bg-slate-800 text-white text-xs rounded-lg opacity-0 group-hover:opacity-100 transition-all duration-200 whitespace-nowrap pointer-events-none font-mono shadow-xl border border-white/5 translate-y-2 group-hover:translate-y-0">
        philippeho27@gmail.com
      </span>
    </a>
  </div>
</section>
