---
import '../styles/resume.css';
import fs from 'node:fs';

const embeddedResumeData = fs.readFileSync(
    new URL('../../public/data/resumes/game-full-stack.json', import.meta.url),
    'utf-8'
);
const embeddedRegistry = fs.readFileSync(
    new URL('../../public/data/resumes/index.json', import.meta.url),
    'utf-8'
);
---

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title id="page-title">Philippe Ho - Resume</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Source+Sans+3:wght@300;400;600;700&display=swap" rel="stylesheet">
</head>

<body id="resume-body">
    <header id="resume-toolbar" class="resume-toolbar">
        <div class="resume-toolbar-primary">
            <a id="portfolio-link" class="toolbar-link" href="/#projects">
                <i class="fas fa-arrow-left" aria-hidden="true"></i>
                Portfolio
            </a>
            <label class="cv-selector-label" for="cv-select">
                <span>CV version</span>
                <select id="cv-select" aria-label="CV version"></select>
            </label>
        </div>
        <div class="resume-toolbar-actions">
            <button id="lang-toggle" type="button">FR</button>
            <button id="print-resume" type="button">
                <i class="fas fa-print" aria-hidden="true"></i>
                Print / PDF
            </button>
            <button id="edit-toggle" type="button">
                <i class="fas fa-pen" aria-hidden="true"></i>
                Edit
            </button>
            <div id="editor-actions" hidden>
                <button id="rename-cv" type="button">Rename</button>
                <button id="duplicate-cv" type="button">Duplicate</button>
                <button id="new-blank-cv" type="button">New Blank</button>
                <button id="save-cv" type="button">Save</button>
                <button id="history-cv" type="button">History</button>
                <button id="exit-edit" type="button">Exit editing</button>
            </div>
        </div>
        <p id="resume-status" role="status" aria-live="polite"></p>
    </header>

    <dialog id="editor-login-dialog" aria-labelledby="editor-login-title">
        <form id="editor-login-form">
            <h2 id="editor-login-title">Unlock CV editor</h2>
            <p>Enter the editor password to manage CV versions.</p>
            <label for="editor-password">Password</label>
            <input id="editor-password" name="password" type="password" autocomplete="current-password" required>
            <p id="editor-login-error" class="dialog-error" role="alert"></p>
            <div class="dialog-actions">
                <button id="editor-login-submit" type="submit">Unlock</button>
                <button type="submit" formmethod="dialog" value="cancel">Cancel</button>
            </div>
        </form>
    </dialog>

    <dialog id="cv-name-dialog" aria-labelledby="cv-name-title">
        <form id="cv-name-form">
            <h2 id="cv-name-title">Name CV</h2>
            <label for="cv-name-input">CV name</label>
            <input id="cv-name-input" name="name" type="text" maxlength="80" required>
            <p id="cv-name-error" class="dialog-error" role="alert"></p>
            <div class="dialog-actions">
                <button id="cv-name-submit" type="submit">Save</button>
                <button type="submit" formmethod="dialog" value="cancel">Cancel</button>
            </div>
        </form>
    </dialog>

    <dialog id="cv-history-dialog" aria-labelledby="cv-history-title">
        <div class="dialog-content">
            <h2 id="cv-history-title">CV history</h2>
            <p id="cv-history-error" class="dialog-error" role="alert"></p>
            <div id="cv-history-list"></div>
            <div id="restore-confirmation" class="restore-confirmation" hidden>
                <p>Restore <strong id="restore-backup-name"></strong>? The current version will be backed up first.</p>
                <div class="dialog-actions">
                    <button id="confirm-restore" type="button">Confirm restore</button>
                    <button id="cancel-restore" type="button">Cancel</button>
                </div>
            </div>
            <form method="dialog" class="dialog-actions">
                <button type="submit">Close</button>
            </form>
        </div>
    </dialog>

    <dialog id="discard-edit-dialog" aria-labelledby="discard-edit-title">
        <div class="dialog-content">
            <h2 id="discard-edit-title">Discard unsaved changes?</h2>
            <p>Your current edits will be lost.</p>
            <div class="dialog-actions">
                <button id="confirm-exit-edit" type="button">Discard and exit</button>
                <form method="dialog"><button type="submit">Keep editing</button></form>
            </div>
        </div>
    </dialog>

    <div class="container" id="resume-content">
        <aside class="sidebar">
            <header>
                <h1 id="name"></h1>
                <h2 id="role"></h2>
            </header>
            <div class="profile">
                <div class="profile-img">
                    <img src={import.meta.env.BASE_URL + "assets/img/profile2.webp"} alt="Profile" id="profile-img">
                </div>
                <div class="contact-info">
                    <p><i class="far fa-envelope fa-fw"></i> <span id="email">philippeho27@gmail.com</span></p>
                    <p><i class="fas fa-phone fa-fw"></i> <span id="phone">(514) 713-5487</span></p>
                    <p><i class="fas fa-map-marker-alt fa-fw"></i> <span id="location"></span></p>
                    <div class="social-row">
                        <a id="link-website" href="#" target="_blank" title="Personal Website"><i
                                class="fas fa-globe"></i></a>
                        <a id="link-linkedin" href="#" target="_blank" title="LinkedIn"><i
                                class="fab fa-linkedin"></i></a>
                        <a id="link-github" href="#" target="_blank" title="GitHub"><i class="fab fa-github"></i></a>
                    </div>
                </div>
                <div class="social-links" id="social-links">
                    <!-- Social links rendered here -->
                </div>
            </div>

            <div id="sidebar-sections">
                <!-- Sidebar sections rendered here -->
            </div>
        </aside>

        <main class="content">
            <section class="summary">
                <h2 id="summary-title"></h2>
                <p id="summary-text"></p>
            </section>

            <section class="experience">
                <h2 id="experience-title"></h2>
                <div id="experience-list"></div>
            </section>

            <section class="projects">
                <h2 id="projects-title"></h2>
                <div id="projects-list"></div>
            </section>

            <section class="education">
                <h2 id="education-title"></h2>
                <div id="education-list"></div>
            </section>
        </main>
    </div>
    <script id="initial-resume-data" type="application/json" set:html={embeddedResumeData}></script>
    <script id="initial-resume-registry" type="application/json" set:html={embeddedRegistry}></script>
    <script>
        import '../scripts/resume/main.ts';
    </script>
</body>

</html>
