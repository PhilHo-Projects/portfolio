---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Experience from '../components/Experience.astro';
import Projects from '../components/Projects.astro';
import Background from '../components/Background.astro';
---

<Layout>
  <Hero />
  <div class="space-y-12">
    <Experience />
    <Projects />
    <Background />
  </div>

  <!-- Modal HTML Structure (Hidden by default, used by scripts/main.ts) -->
  <div id="project-modal"
    class="fixed inset-0 z-200 hidden items-center justify-center p-4 md:p-12 bg-black/80 backdrop-blur-md">
    <div id="modal-content"
      class="relative w-full h-full max-w-6xl bg-[#0a0a0a] rounded-xl border border-white/10 shadow-2xl overflow-hidden flex flex-col">

      <!-- Browser Top Bar -->
      <div class="h-10 bg-[#1a1a1a] border-b border-white/10 flex items-center px-4 justify-between shrink-0">
        <div class="flex items-center gap-2">
          <i class="fa-solid fa-earth-americas text-slate-600 text-xs"></i>
          <span id="modal-title" class="text-[10px] font-mono text-slate-500 uppercase tracking-widest ml-2">Web Preview</span>
        </div>

        <div class="hidden md:flex flex-1 mx-20 items-center justify-center">
          <div class="bg-black/40 border border-white/5 px-4 py-1 rounded-md text-[10px] font-mono text-slate-500 flex items-center gap-2 min-w-[300px] justify-center">
            <i class="fa-solid fa-lock text-[8px]"></i>
            <span id="modal-url-display">philippeho.popnux.com</span>
          </div>
        </div>

        <button onclick="window.closeProjectModal()" class="text-slate-500 hover:text-white transition-colors" aria-label="Close modal">
          <i class="fa-solid fa-xmark text-lg"></i>
        </button>
      </div>

      <!-- Content Container -->
      <div class="flex-1 bg-white relative">

        <!-- IFRAME MODE (Default) -->
        <div id="iframe-container" class="absolute inset-0 w-full h-full">
          <!-- Loading State -->
          <div id="loading-spinner" class="absolute inset-0 flex flex-col items-center justify-center bg-[#0a0a0a] z-50">
            <div class="w-8 h-8 border-2 border-accent/20 border-t-accent rounded-full animate-spin mb-4"></div>
            <p class="text-[10px] font-mono text-slate-500 uppercase tracking-widest">Connecting to host...</p>
          </div>

          <!-- Error State -->
          <div id="modal-error" class="absolute inset-0 hidden flex-col items-center justify-center bg-[#0a0a0a] z-60 p-12 text-center">
             <div class="w-16 h-16 bg-red-500/10 rounded-full flex items-center justify-center mb-6 border border-red-500/20">
               <i class="fa-solid fa-triangle-exclamation text-red-500 text-2xl"></i>
             </div>
             <h4 class="text-2xl font-medium text-slate-200 mb-4">Unable to Load Project</h4>
             <p class="text-slate-500 max-w-md mb-8 leading-relaxed text-sm">
               This project might be temporarily offline, or your browser is blocking it from being displayed inside the portfolio for security reasons.
             </p>
             <div class="flex gap-4">
               <button id="error-retry-btn" class="px-6 py-2 bg-white/5 border border-white/10 rounded-md text-[10px] font-mono uppercase tracking-widest text-slate-300 hover:bg-white/10 transition-all cursor-pointer">
                 Try Again
               </button>
               <a id="modal-external-link" href="#" target="_blank" class="px-6 py-2 bg-accent text-background rounded-md text-[10px] font-mono uppercase tracking-widest font-bold hover:brightness-110 transition-all">
                 Open in New Window
               </a>
             </div>
          </div>

          <iframe id="project-iframe" src="about:blank" class="w-full h-full border-none relative z-10"></iframe>
        </div>

        <!-- CAROUSEL MODE -->
        <div id="carousel-container" class="absolute inset-0 w-full h-full bg-[#050505] hidden flex items-center justify-center overflow-hidden">
          <div class="absolute inset-0 flex items-center justify-center opacity-10 pointer-events-none">
            <img src="/assets/img/ue5-course.png" class="w-2/3 h-2/3 object-contain grayscale" alt="Background Logo">
          </div>
          <div class="relative z-10 max-w-4xl w-full p-12 flex flex-col items-center text-center">
            <h3 id="carousel-title" class="text-4xl md:text-5xl font-medium text-white mb-4 tracking-tight drop-shadow-xl">Title Placeholder</h3>
            <p id="carousel-instructor" class="text-sm font-mono text-slate-500 uppercase tracking-widest mb-12">Instructor: Name</p>
            <p id="carousel-desc" class="text-slate-300 text-lg md:text-2xl leading-relaxed max-w-2xl drop-shadow-lg mb-16">Description goes here.</p>
            <button id="carousel-prev" class="absolute left-0 md:-left-12 top-1/2 -translate-y-1/2 w-16 h-16 text-white/20 hover:text-white transition-colors flex items-center justify-center group">
              <i class="fa-solid fa-chevron-left text-4xl group-hover:-translate-x-1 transition-transform"></i>
            </button>
            <button id="carousel-next" class="absolute right-0 md:-right-12 top-1/2 -translate-y-1/2 w-16 h-16 text-white/20 hover:text-white transition-colors flex items-center justify-center group">
              <i class="fa-solid fa-chevron-right text-4xl group-hover:translate-x-1 transition-transform"></i>
            </button>
            <div class="flex gap-4" id="carousel-dots"></div>
          </div>
        </div>

        <!-- IMAGE VIEWER MODE -->
        <div id="image-viewer-container" class="absolute inset-0 w-full h-full bg-[#050505] hidden items-center justify-center p-8">
          <img id="modal-single-image" src="" alt="Preview" class="max-w-full max-h-full object-contain shadow-2xl rounded-lg border border-white/5">
        </div>

        <!-- Modal Footer -->
        <div class="h-6 bg-[#1a1a1a] border-t border-white/10 flex items-center px-4 shrink-0 justify-between">
          <div class="flex items-center gap-2">
            <div class="w-1.5 h-1.5 rounded-full bg-green-500 animate-pulse"></div>
            <p class="text-[9px] font-mono text-slate-600 uppercase tracking-widest">System Live</p>
          </div>
          <p class="text-[9px] font-mono text-slate-600 uppercase tracking-widest">Press ESC to exit</p>
        </div>
      </div>
    </div>
  </div>
</Layout>
